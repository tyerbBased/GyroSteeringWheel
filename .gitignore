# Gradle
.gradle/
build/
app/build/

# Android Studio / IntelliJ
.idea/
captures/
*.iml

# Machine-specific SDK path (created by tools/setup_toolchain.sh)
local.properties

# Build outputs (published APK lives in releases/)
*.apk
!releases/*.apk

# Python
__pycache__/
*.pyc

# Toolchain downloads (the setup/build scripts ARE committed, downloads are not)
tools/*
!tools/setup_toolchain.sh
!tools/build_apk.sh

# Editor swap files
*.kate-swp
*.swp
*~
